# Copy this file to .env.local and fill in the values.
# Get the Clerk keys from https://dashboard.clerk.com → your app → API Keys.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Routing — these tell Clerk where to send users.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase — get from https://supabase.com → your project → Settings → API.
# The service_role key is SECRET. Never expose it client-side; it's used only on the server.
NEXT_PUBLIC_SUPABASE_URL=https://replace_me.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ_replace_me
SUPABASE_SERVICE_ROLE_KEY=eyJ_replace_me
